{
  "enabled": true,
  "mode": "auto",
  "jevEndpoint": "https://api.typesafe.ai/v1/systemone",
  "jevModel": "jev-latest",
  "timeoutMs": 3000,
  "historyTurns": 0,
  "confidenceThreshold": 0.65,
  "minPromptChars": 1,
  "stickiness": true,
  "routes": {
    "quick": [
      {
        "provider": "anthropic",
        "model": "claude-opus-5-5",
        "thinkingLevel": "low"
      }
    ],
    "standard": [
      {
        "provider": "anthropic",
        "model": "claude-opus-5-5",
        "thinkingLevel": "medium"
      }
    ],
    "high": [
      {
        "provider": "anthropic",
        "model": "claude-opus-5-5",
        "thinkingLevel": "high"
      }
    ],
    "premium": [
      {
        "provider": "anthropic",
        "model": "claude-opus-5-5",
        "thinkingLevel": "xhigh"
      }
    ],
    "xpremium": [
      {
        "provider": "anthropic",
        "model": "claude-fable-5-2",
        "thinkingLevel": "high"
      },
      {
        "provider": "anthropic",
        "model": "claude-opus-5-5",
        "thinkingLevel": "xhigh"
      }
    ]
  },
  "kindModels": {},
  "free": {
    "enabled": false,
    "policy": "fallback-only",
    "pool": []
  },
  "cache": {
    "aware": false
  },
  "quota": {
    "codex": {
      "enabled": false
    }
  },
  "budgets": {
    "dailyCapUsd": 0,
    "weeklyCapUsd": 0,
    "reserveUsd": 0,
    "downgradeOnPressure": false,
    "softMode": "balanced"
  },
  "confirm": {
    "tiers": [],
    "onTimeout": "reject"
  }
}
